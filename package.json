{
  "name": "flowstate-focus-app",
  "version": "1.0.0",
  "description": "Indefinite Focus & On-Demand Guided Break Desktop App with Global Hotkeys",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:start": "electron .",
    "package": "npm run build && electron-builder --mac",
    "package:dir": "npm run build && electron-builder --mac dir"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "ffmpeg-static": "^5.3.0",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.dhanvidesu.flowstate",
    "productName": "FlowState",
    "asar": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!dist/audio/*_orig.m4a",
      "!dist/audio/focus_music.mp4",
      "!dist/audio/spotify_focus_mix.m4a",
      "!dist/audio/*.json",
      "!dist/audio/spotify_playlist/concat_list.txt"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "directories": {
      "output": "release"
    }
  }
}
